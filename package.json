  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "eval": "tsx server/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build web",
    "dev:web": "vite web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bryntum/scheduler-enterprise": "^8.0.0",
    "@bryntum/scheduler-react-enterprise": "^8.0.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
