# Copy to .env and fill in. Never commit .env.

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Set after creating the webhook in the PayPal developer dashboard
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
# Sandbox business account email (the creator / invoicer)
PAYPAL_CREATOR_EMAIL=creator-business@example.com
# Sandbox personal account emails standing in for each child's trust account
PAYPAL_TRUST_EMAIL_MIA=mia-trust@example.com
PAYPAL_TRUST_EMAIL_LEO=leo-trust@example.com
PAYPAL_TRUST_EMAIL_NOAH=noah-trust@example.com
# Sandbox personal account that plays the brand (payer)
PAYPAL_BRAND_EMAIL=brand-buyer@example.com

# --- AI ---
# vertex (GCP project, recommended) or aistudio (GEMINI_API_KEY; free tier is 20 requests/day/model)
AI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
# Locally Vertex uses your `gcloud auth login`. On a server, paste a service-account key JSON here.
GOOGLE_SERVICE_ACCOUNT_JSON=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Spend guard: AI calls are refused past these caps (cost estimated from token usage). Flash-tier models only.
AI_DAILY_BUDGET_USD=0.50
AI_TOTAL_BUDGET_USD=3.00
AI_MAX_VIDEO_SEC=180

# --- Bryntum (trial key from the Bryntum email; served to the browser at runtime, never committed) ---
BRYNTUM_LICENSE_KEY=your-bryntum-trial-license-key

# --- App ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
