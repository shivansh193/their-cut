# Copy to .env and fill in. Never commit .env.

# --- PayPal (SANDBOX ONLY) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Set after creating the webhook in the PayPal developer dashboard
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
# Sandbox business account email (the creator / invoicer)
PAYPAL_CREATOR_EMAIL=creator-business@example.com
# Sandbox personal account emails standing in for each child's trust account
PAYPAL_TRUST_EMAIL_MIA=mia-trust@example.com
PAYPAL_TRUST_EMAIL_LEO=leo-trust@example.com
# Sandbox personal account that plays the brand (payer)
PAYPAL_BRAND_EMAIL=brand-buyer@example.com

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
