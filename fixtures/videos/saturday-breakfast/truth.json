  "narration": [
    {
      "start": 0.5,
      "end": 7.029,
      "text": "Hey everyone, welcome back to the kitchen! Today we're making a big Saturday breakfast.",
      "subjects": []
    },
    {
      "start": 7.329,
      "end": 12.573,
      "text": "Leo is in charge of grapes today, and he takes that job very seriously.",
      "subjects": [
        "leo"
      ]
    },
    {
      "start": 16.16,
      "end": 21.474,
      "text": "Mia picked every single berry in this bowl herself, and she wants you to know it.",
      "subjects": [
        "mia"
      ]
    },
    {
      "start": 22.16,
      "end": 26.86,
      "text": "Our kitchen rule: grown-ups slice, kids arrange.",
      "subjects": []
    },
    {
      "start": 31.06,
      "end": 37.23,
      "text": "And here's Noah, our tiniest taste tester. He mostly eats the blueberries.",
      "subjects": [
        "noah"
      ]
    },
    {
      "start": 46.76,
      "end": 52.399,
      "text": "While the pancakes cook, a quick thank you to today's sponsor, Sunny Oats.",
      "subjects": []
    },
    {
      "start": 52.76,
      "end": 55.319,
      "text": "Everyone gets a seat at the table.",
      "subjects": []
    },
    {
      "start": 73.82,
      "end": 78.109,
      "text": "Mia says she'll do the dishes. We'll see about that.",
      "subjects": [
        "mia"
      ]
    },
    {
      "start": 78.409,
      "end": 80.479,
      "text": "She always says that.",
      "subjects": [
        "mia"
      ]
    },
    {
      "start": 80.82,
      "end": 85.504,
      "text": "Thanks for hanging out with us. See you next Saturday!",
      "subjects": []
    }
  ],
